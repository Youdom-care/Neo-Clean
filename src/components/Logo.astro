---
// Logo Neo Clean redessiné en SVG (reprend le bleu, le rose et le vert de l'identité existante).
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---
<span class:list={["logo", { "logo--light": light }]}>
  <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="10" fill="#1f5fd1" />
    <path d="M9 25V11l9 9 9-9v14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="27.5" cy="8.5" r="3.5" fill="#d81e6c" />
    <circle cx="8.5" cy="27.5" r="2.5" fill="#a8c82f" />
  </svg>
  <span class="logo__text">Neo<b>Clean</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--navy);
  }
  .logo__text {
    font: 600 1.3rem/1 var(--display);
    letter-spacing: -0.03em;
  }
  .logo__text b {
    font-weight: 700;
    color: var(--blue);
  }
  .logo--light {
    color: #fff;
  }
  .logo--light .logo__text b {
    color: #9dbcf3;
  }
</style>
