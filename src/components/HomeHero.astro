---
// En-tête de la page d'accueil : titre local, promesse, deux actions, une photo.
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { site } from "../data/site";
---
<section class="hh">
  <div class="wrap hh__grid">
    <div class="hh__text">
      <p class="eyebrow">Nettoyage professionnel et ménage à domicile</p>
      <h1>Entreprise de nettoyage à Paris et en Île-de-France</h1>
      <p class="lede">
        Bureaux, commerces, copropriétés et domiciles, entretenus par un agent attitré, avec un cahier des charges écrit et un responsable joignable directement.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/devis/">Demander un devis gratuit <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
      </div>
    </div>

    <div class="hh__media">
      <Photo name="accueil-2" loading="eager" sizes="(max-width: 900px) 100vw, 45vw" position="50% 28%" class="hh__img" />
    </div>
  </div>
</section>

<style>
  .hh {
    padding-block: clamp(40px, 6vw, 88px);
    background: linear-gradient(180deg, var(--paper) 0%, var(--white) 100%);
    border-bottom: 1px solid var(--line);
  }
  .hh__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .hh__text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .eyebrow {
    margin: 0;
    line-height: 1.5;
  }
  h1 {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }
  .lede {
    font-size: 1.15rem;
    max-width: 48ch;
  }
  .actions {
    margin-top: 4px;
  }
  .hh__media {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: 600px;
    width: 100%;
    justify-self: end;
    box-shadow: 0 30px 60px -30px rgb(18 48 107 / 0.35);
  }
  .hh__media :global(picture),
  .hh__media :global(.hh__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hh__grid {
      grid-template-columns: 1fr;
    }
    .hh__media {
      aspect-ratio: 16 / 10;
      max-height: none;
    }
  }
  @media (max-width: 560px) {
    .actions,
    .actions :global(.btn) {
      width: 100%;
    }
  }
</style>
