---
// En-tête de la page d'accueil : fond bleu marine, texte à gauche,
// photo pleine hauteur à droite jusqu'au bord de l'écran.
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { site } from "../data/site";
---
<section class="hh">
  <div class="hh__media">
    <Photo name="coworking-2" loading="eager" sizes="(max-width: 900px) 100vw, 55vw" position="35% 40%" class="hh__img" />
  </div>
  <div class="wrap hh__inner">
    <div class="hh__text">
      <p class="hh__eyebrow">Nettoyage professionnel et ménage à domicile</p>
      <h1>Entreprise de nettoyage à <span>Paris et en Île-de-France</span></h1>
      <p class="hh__lede">
        Bureaux, commerces, copropriétés et domiciles, entretenus par un agent attitré, avec un cahier des charges écrit et un responsable joignable directement.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/devis/">Demander un devis gratuit <Icon name="arrow" size={18} /></a>
        <a class="btn btn--outline" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hh {
    position: relative;
    background: var(--navy);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  /* halo bleu discret derrière le texte */
  .hh::before {
    content: "";
    position: absolute;
    left: -200px;
    top: -220px;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(31 95 209 / 0.55), transparent 70%);
    z-index: -1;
  }
  .hh__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52%;
    z-index: -1;
  }
  .hh__media :global(picture),
  .hh__media :global(.hh__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* fondu du bleu vers la photo */
  .hh__media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, var(--navy) 0%, rgb(18 48 107 / 0.55) 22%, transparent 55%);
  }
  .hh__inner {
    min-height: clamp(520px, 62vh, 640px);
    display: flex;
    align-items: center;
    padding-block: clamp(56px, 8vw, 104px) clamp(96px, 10vw, 136px);
  }
  .hh__text {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 560px;
  }
  .hh__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font: 600 0.8rem/1.5 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .hh__eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--lime);
    flex: none;
  }
  h1 {
    font-size: clamp(2.3rem, 4.4vw, 3.7rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #fff;
  }
  h1 span {
    color: #9dbcf3;
  }
  .hh__lede {
    margin: 0;
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.82);
    max-width: 48ch;
  }
  .btn--outline {
    border-color: rgb(255 255 255 / 0.35);
    color: #fff;
    background: rgb(255 255 255 / 0.06);
  }
  .btn--outline:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  @media (max-width: 900px) {
    .hh__media {
      position: relative;
      width: 100%;
      height: 300px;
      z-index: 0;
    }
    .hh__media::before {
      background: linear-gradient(0deg, var(--navy) 0%, transparent 45%);
    }
    .hh__inner {
      min-height: 0;
      padding-block: 8px 104px;
    }
  }
  @media (max-width: 560px) {
    .hh__media {
      height: 240px;
    }
    .actions,
    .actions :global(.btn) {
      width: 100%;
    }
  }
</style>
