---
// En-tête photo pour les pages de rubrique (Entreprises, Particuliers, Zones…).
import Photo from "./Photo.astro";
interface Props {
  crumb: string;
  eyebrow: string;
  title: string;
  lede: string;
  photo: string;
  position?: string;
}
const { crumb, eyebrow, title, lede, photo, position } = Astro.props;
---
<section class="hh">
  <div class="hh__bg"><Photo name={photo} loading="eager" sizes="100vw" position={position} class="hh__img" /></div>
  <div class="wrap hh__inner">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <span class="hh__eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="hh__lede">{lede}</p>
    <slot />
  </div>
</section>

<style>
  .hh {
    position: relative;
    color: #fff;
    background: var(--ink);
    overflow: hidden;
  }
  .hh__bg {
    position: absolute;
    inset: 0;
  }
  .hh__bg :global(picture),
  .hh__bg :global(.hh__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hh__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg, rgb(12 25 50 / 0.95) 0%, rgb(12 25 50 / 0.8) 50%, rgb(12 25 50 / 0.35) 100%);
  }
  .hh__inner {
    position: relative;
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: clamp(48px, 8vw, 120px);
  }
  .hh .crumbs ol {
    margin: 0;
    color: rgb(255 255 255 / 0.7);
  }
  .hh .crumbs a {
    color: rgb(255 255 255 / 0.8);
  }
  .hh .crumbs li + li::before {
    color: rgb(255 255 255 / 0.4);
  }
  .hh__eyebrow {
    font: 600 0.8rem var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .hh h1 {
    font-size: clamp(2.1rem, 4.8vw, 3.6rem);
    max-width: 20ch;
  }
  .hh__lede {
    font-size: 1.2rem;
    color: rgb(255 255 255 / 0.85);
    max-width: 58ch;
  }
</style>
