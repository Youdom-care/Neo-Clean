---
// Photo optimisée (AVIF + WebP, plusieurs tailles) à partir de src/assets/photos/.
import { Picture } from "astro:assets";
import { photo, alt as altFor } from "../lib/photos";

interface Props {
  name: string;
  alt?: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  loading?: "eager" | "lazy";
  position?: string; // object-position, ex. "70% 50%"
}
const {
  name,
  alt,
  sizes = "(max-width: 900px) 100vw, 50vw",
  widths = [480, 800, 1200, 1600],
  class: className,
  loading = "lazy",
  position = "50% 50%",
} = Astro.props;
const img = photo(name);
const usable = widths.filter((w) => w <= img.width);
---
<Picture
  src={img}
  alt={alt ?? altFor(name)}
  formats={["avif", "webp"]}
  fallbackFormat="jpg"
  widths={usable.length ? usable : [img.width]}
  sizes={sizes}
  loading={loading}
  fetchpriority={loading === "eager" ? "high" : undefined}
  class={className}
  style={`object-position:${position}`}
/>
