---
// Les 4 étapes de démarrage d'une prestation, partagées entre plusieurs pages.
interface Props {
  title?: string;
  audience?: "pro" | "particulier";
}
const { title = "Comment se passe la mise en place", audience = "pro" } = Astro.props;

const steps =
  audience === "pro"
    ? [
        { t: "Votre demande", d: "Vous décrivez vos locaux et votre besoin par le formulaire ou par téléphone. Nous vous rappelons sous 24 h ouvrées." },
        { t: "Visite gratuite", d: "Un responsable visite vos locaux, note les surfaces, les contraintes d'accès et vos attentes, pièce par pièce." },
        { t: "Devis et cahier des charges", d: "Vous recevez un devis détaillé et un cahier des charges écrit : ce qui est fait, à quelle fréquence, à quel prix." },
        { t: "Démarrage et suivi", d: "Votre agent attitré est formé sur place. Le responsable de secteur contrôle la qualité et reste joignable." },
      ]
    : [
        { t: "Votre demande", d: "Vous décrivez votre logement et vos attentes en ligne ou par téléphone. Nous vous rappelons sous 24 h ouvrées." },
        { t: "Premier échange", d: "Nous faisons le point sur vos priorités, vos habitudes et vos consignes, par téléphone ou chez vous." },
        { t: "Votre intervenante", d: "Nous vous présentons une intervenante qui habite votre secteur, disponible aux jours et heures choisis." },
        { t: "Suivi et remplacement", d: "Nous restons joignables, ajustons le service si besoin et organisons les remplacements pendant les congés." },
      ];
---
<section class="section process">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Notre méthode</span>
      <h2>{title}</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .process::before {
    content: "";
    position: absolute;
    right: -120px;
    top: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(31 95 209 / 0.55), transparent 70%);
  }
  .process .eyebrow {
    color: var(--lime);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
    counter-reset: s;
  }
  .steps li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px 24px 0 0;
    border-top: 2px solid rgb(255 255 255 / 0.18);
    position: relative;
  }
  .steps li::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lime);
  }
  .n {
    font: 700 2.4rem/1 var(--display);
    color: rgb(255 255 255 / 0.22);
    letter-spacing: -0.03em;
  }
  .steps p {
    color: rgb(255 255 255 / 0.75);
    font-size: 0.97rem;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
