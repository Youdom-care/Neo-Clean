---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const business = {
  "@context": "https://schema.org",
  "@type": "HousekeepingService",
  "@id": `${site.url}/#entreprise`,
  name: site.name,
  url: site.url,
  telephone: site.phone.replace(/\s/g, ""),
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHours: site.hoursSchema,
  areaServed: { "@type": "AdministrativeArea", name: "Île-de-France" },
  priceRange: "€€",
};
const graphs = [business, ...schema];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#12306b" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--navy);
    color: #fff;
    border-radius: 8px;
  }
  .skip:focus {
    top: 12px;
  }
</style>
