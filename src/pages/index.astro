---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
import { proServices, homeServices } from "../data/services";
import { zones } from "../data/zones";

const featured = proServices.slice(0, 8);

const steps = [
  { t: "Vous décrivez votre besoin", d: "Par le formulaire ou par téléphone : type de locaux, surface, fréquence souhaitée." },
  { t: "Visite gratuite et devis", d: "Nous visitons vos locaux et vous envoyons un devis détaillé avec un cahier des charges écrit." },
  { t: "Un agent attitré", d: "Le même agent intervient à chaque passage. Il connaît vos locaux et vos consignes." },
  { t: "Suivi et contrôle", d: "Un responsable de secteur contrôle la qualité et reste votre interlocuteur direct." },
];

const promises = [
  { i: "user", t: "Un interlocuteur unique", d: "Un responsable de secteur joignable directement, qui connaît votre dossier." },
  { i: "shield", t: "Personnel déclaré et assuré", d: "Agents salariés, formés à nos protocoles et couverts par notre assurance responsabilité civile professionnelle." },
  { i: "calendar", t: "Continuité du service", d: "En cas d'absence, un remplaçant formé sur votre site assure le passage." },
  { i: "doc", t: "Sans engagement caché", d: "Devis détaillé, contrat clair, résiliable avec préavis. Pas de frais de dossier." },
];

const faq = [
  { q: "Combien coûte le nettoyage de bureaux ?", a: "Le prix dépend de la surface, du type de locaux, de la fréquence des passages et des prestations incluses. Nous établissons un devis précis et gratuit après une visite, sans frais de dossier." },
  { q: "Dans quelles villes intervenez-vous ?", a: "À Paris et dans toute l'Île-de-France : Hauts-de-Seine, Seine-Saint-Denis, Val-de-Marne, Yvelines, Essonne, Val-d'Oise et Seine-et-Marne." },
  { q: "Quel est le délai pour démarrer ?", a: "Après validation du devis, nous démarrons en général sous une à deux semaines, le temps d'affecter et de former l'agent sur votre site." },
  { q: "Les particuliers bénéficient-ils du crédit d'impôt ?", a: "Oui, le ménage à domicile ouvre droit à un crédit d'impôt de 50 % des sommes versées, dans les conditions prévues par l'article 199 sexdecies du Code général des impôts. Avec l'avance immédiate, vous ne payez que la moitié de la facture chaque mois." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Neo Clean · Entreprise de nettoyage de bureaux à Paris et en Île-de-France"
  description="Nettoyage de bureaux, commerces, copropriétés et ménage à domicile à Paris et en Île-de-France. Agent attitré, visite et devis gratuits sous 24 h."
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <span class="eyebrow">Paris et Île-de-France</span>
        <h1>Des locaux propres chaque matin, <span class="hl">sans y penser.</span></h1>
        <p class="lede">
          Neo Clean entretient les bureaux, commerces et immeubles d'Île-de-France avec un agent attitré, un cahier des charges écrit et un responsable joignable directement.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="/devis/">Demander un devis gratuit <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        </div>
        <ul class="hero__proof">
          <li><Icon name="check" size={18} />Visite et devis gratuits</li>
          <li><Icon name="check" size={18} />Réponse sous 24 h ouvrées</li>
          <li><Icon name="check" size={18} />Sans frais de dossier</li>
        </ul>
      </div>

      <!-- Fiche de passage : montre concrètement ce que reçoit le client -->
      <figure class="sheet" aria-label="Exemple de fiche de passage">
        <header class="sheet__head">
          <div>
            <span class="sheet__label">Exemple de fiche de passage</span>
            <strong>Bureaux · 3e étage · 180 m²</strong>
          </div>
          <span class="sheet__time">Mar. 06:30</span>
        </header>
        <ul class="sheet__list">
          <li class="done"><Icon name="check" size={16} />Sols aspirés et lavés</li>
          <li class="done"><Icon name="check" size={16} />Postes de travail dépoussiérés</li>
          <li class="done"><Icon name="check" size={16} />Sanitaires désinfectés, savon rechargé</li>
          <li class="done"><Icon name="check" size={16} />Cuisine : plans, évier, micro-ondes</li>
          <li class="done"><Icon name="check" size={16} />Corbeilles vidées, tri respecté</li>
          <li class="todo"><span class="dot"></span>Vitres de la salle de réunion · jeudi</li>
        </ul>
        <footer class="sheet__foot">
          <span class="avatar" aria-hidden="true">AK</span>
          <div><strong>Aminata K.</strong><span>Votre agent attitré</span></div>
          <span class="badge">5/6 ✓</span>
        </footer>
        <figcaption class="visually-hidden">Exemple de compte rendu de passage envoyé au client.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Deux publics -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Nos clients</span>
        <h2>Professionnels ou particuliers, un service pensé pour vous</h2>
      </div>
      <div class="split">
        <a class="split__card split__card--pro" href="/nettoyage-professionnel/">
          <Icon name="building" size={32} />
          <h3>Entreprises, commerces et copropriétés</h3>
          <p>Bureaux, coworkings, boutiques, cabinets médicaux, parties communes, fins de chantier. Contrat d'entretien régulier ou intervention ponctuelle.</p>
          <span class="more">Voir les services professionnels <Icon name="arrow" size={18} /></span>
        </a>
        <a class="split__card split__card--home" href="/services-de-menage-a-domicile/">
          <Icon name="heart" size={32} />
          <h3>Particuliers</h3>
          <p>Ménage régulier ou ponctuel, repassage, locations Airbnb, aide aux seniors. 50 % de crédit d'impôt et avance immédiate.</p>
          <span class="more">Voir le ménage à domicile <Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Services pro -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Services aux entreprises</span>
        <h2>Ce que nous entretenons</h2>
        <p class="lede">Chaque prestation fait l'objet d'un cahier des charges écrit : vous savez exactement ce qui est fait, à quelle fréquence.</p>
      </div>
      <div class="grid-cards">
        {featured.map((s) => (
          <a class="svc-card" href={`/${s.slug}/`}>
            <span class="ico"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <p class="all"><a href="/nettoyage-professionnel/">Voir les {proServices.length} services professionnels</a></p>
    </div>
  </section>

  <!-- Méthode -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow eyebrow--lime">Notre méthode</span>
        <h2>De la première visite au passage quotidien</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__n">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Engagements -->
  <section class="section">
    <div class="wrap promises">
      <div class="section-head">
        <span class="eyebrow">Nos engagements</span>
        <h2>Ce qui change avec Neo Clean</h2>
        <p class="lede">Le problème le plus fréquent avec un prestataire de nettoyage, c'est un agent différent chaque semaine et personne à qui parler. Nous avons construit notre organisation pour l'éviter.</p>
      </div>
      <ul class="promises__list">
        {promises.map((p) => (
          <li>
            <span class="ico"><Icon name={p.i} /></span>
            <div><h3>{p.t}</h3><p>{p.d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Particuliers -->
  <section class="section section--paper">
    <div class="wrap home">
      <div class="home__text">
        <span class="eyebrow">Ménage à domicile</span>
        <h2>Chez vous, la même intervenante à chaque passage</h2>
        <p class="lede">Nous recrutons, déclarons et remplaçons votre intervenante. Vous n'avez aucune démarche d'employeur, et vous bénéficiez de 50 % de crédit d'impôt.</p>
        <div class="price">
          <span class="price__label">Ménage à domicile, à partir de</span>
          <span class="price__value">17,65 €<small>/h</small></span>
          <span class="price__note">après crédit d'impôt, soit 35,30 € TTC facturés</span>
        </div>
        <div class="actions">
          <a class="btn btn--primary" href="/devis/?type=particulier">Demander un devis</a>
          <a class="btn btn--ghost" href="/tarifs/">Voir les tarifs</a>
        </div>
      </div>
      <ul class="home__list">
        {homeServices.map((s) => (
          <li>
            <a href={`/${s.slug}/`}>
              <span class="ico"><Icon name={s.icon} size={20} /></span>
              <span><strong>{s.title}</strong><small>{s.summary}</small></span>
              <Icon name="arrow" size={18} class="arr" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Zones -->
  <section class="section">
    <div class="wrap zones">
      <div>
        <span class="eyebrow">Zone d'intervention</span>
        <h2>Paris et toute l'Île-de-France</h2>
        <p class="lede">Nos équipes sont organisées par secteur pour limiter les trajets et garantir la ponctualité.</p>
      </div>
      <ul class="zones__list">
        {zones.map((z) => <li><a href={`/${z.slug}/`}><Icon name="pin" size={18} />{z.name} ({z.code})</a></li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Vos questions, nos réponses</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
      <p class="all"><a href="/faq/">Toutes les questions fréquentes</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 88px);
    background:
      radial-gradient(900px 400px at 85% 10%, var(--blue-soft), transparent 70%),
      var(--white);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero__text {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .hl {
    color: var(--blue);
  }
  .hero__proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 4px 0 0;
    padding: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__proof :global(svg) {
    color: var(--lime);
    stroke-width: 2.4;
  }

  .sheet {
    margin: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 30px 60px -20px rgb(18 48 107 / 0.25), var(--shadow);
    padding: 22px;
    display: grid;
    gap: 16px;
    transform: rotate(1.2deg);
  }
  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line);
  }
  .sheet__head div {
    display: grid;
    gap: 4px;
  }
  .sheet__label {
    font: 600 0.72rem var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pink);
  }
  .sheet__head strong {
    font: 600 1.02rem var(--display);
  }
  .sheet__time {
    font: 600 0.85rem var(--display);
    background: var(--blue-soft);
    color: var(--navy);
    padding: 6px 10px;
    border-radius: 8px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .sheet__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.95rem;
  }
  .sheet__list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    align-items: center;
    gap: 10px;
  }
  .sheet__list .done :global(svg) {
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 50%;
    background: #eef6d6;
    color: #5b7a00;
    stroke-width: 2.6;
  }
  .sheet__list .todo {
    color: var(--muted);
  }
  .dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px dashed var(--line);
  }
  .sheet__foot {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    display: grid;
    place-items: center;
    font: 600 0.85rem var(--display);
  }
  .sheet__foot div {
    display: grid;
    line-height: 1.3;
  }
  .sheet__foot strong {
    font: 600 0.95rem var(--display);
  }
  .sheet__foot div span {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .badge {
    font: 600 0.85rem var(--display);
    color: #5b7a00;
    background: #eef6d6;
    padding: 6px 10px;
    border-radius: 999px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .split__card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 20px;
    text-decoration: none;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .split__card:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .split__card > :global(svg) {
    color: var(--blue);
  }
  .split__card--home > :global(svg) {
    color: var(--pink);
  }
  .split__card h3 {
    font-size: 1.45rem;
  }
  .split__card p {
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 0.98rem var(--display);
    color: var(--blue);
    margin-top: 6px;
  }

  .all {
    margin-top: 28px;
    font: 600 1rem var(--display);
  }

  .eyebrow--lime {
    color: var(--lime);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    counter-reset: s;
  }
  .steps li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .steps__n {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--lime);
    color: var(--ink);
    font: 700 1rem var(--display);
  }
  .steps p {
    color: rgb(255 255 255 / 0.75);
    font-size: 0.97rem;
  }

  .promises {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .promises .section-head {
    margin: 0;
  }
  .promises__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .promises__list li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .promises__list .ico,
  .home__list .ico {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--blue-soft);
    color: var(--blue);
  }
  .promises__list div {
    display: grid;
    gap: 6px;
  }
  .promises__list p {
    color: var(--muted);
  }

  .home {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .home__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .price {
    display: grid;
    gap: 2px;
    padding: 18px 22px;
    border-left: 4px solid var(--pink);
    background: #fff;
    border-radius: 0 12px 12px 0;
  }
  .price__label {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .price__value {
    font: 700 2.2rem/1.1 var(--display);
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .price__value small {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }
  .price__note {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .home__list a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 14px 18px 14px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .home__list a:hover {
    border-color: var(--pink);
  }
  .home__list .ico {
    background: #fce8f1;
    color: var(--pink);
  }
  .home__list strong {
    display: block;
    font: 600 1.02rem var(--display);
  }
  .home__list small {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .home__list :global(.arr) {
    color: var(--muted);
  }

  .zones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .zones > div {
    display: grid;
    gap: 14px;
  }
  .zones__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .zones__list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .zones__list a:hover {
    border-color: var(--pink);
  }
  .zones__list :global(svg) {
    color: var(--pink);
    flex: none;
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 900px) {
    .hero__grid,
    .promises,
    .home,
    .zones {
      grid-template-columns: 1fr;
    }
    .sheet {
      transform: none;
      max-width: 460px;
    }
  }
  @media (max-width: 640px) {
    .split,
    .steps {
      grid-template-columns: 1fr;
    }
    .hero__text .actions {
      width: 100%;
    }
    .hero__text .btn {
      flex: 1 1 100%;
    }
  }
  @media (max-width: 420px) {
    .zones__list {
      grid-template-columns: 1fr;
    }
  }
</style>
