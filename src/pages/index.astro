---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import HomeHero from "../components/HomeHero.astro";
import Photo from "../components/Photo.astro";
import IdfMap from "../components/IdfMap.astro";
import CtaBand from "../components/CtaBand.astro";
import Process from "../components/Process.astro";
import Commitments from "../components/Commitments.astro";
import { site } from "../data/site";
import { getProServices, getHomeServices, getZones, serviceHref, zoneHref } from "../lib/content";

const pro = await getProServices();
const home = await getHomeServices();
const zones = await getZones();
const featured = pro.slice(0, 8);

const trust = [
  { i: "user", t: "Agent attitré", d: "La même personne à chaque passage" },
  { i: "pin", t: "8 départements", d: "Paris et toute l'Île-de-France" },
  { i: "clock", t: "Devis sous 24 h", d: "Visite de vos locaux offerte" },
  { i: "euro", t: "50 % de crédit d'impôt", d: "Pour le ménage à domicile" },
];


const faq = [
  { q: "Combien coûte le nettoyage de bureaux à Paris ?", a: "Le prix dépend de la surface, du type de locaux, du nombre de sanitaires, de la fréquence des passages et des prestations incluses. Nous établissons un devis précis et gratuit après une visite de vos locaux, sans frais de dossier." },
  { q: "Dans quelles villes intervenez-vous ?", a: "À Paris et dans les sept autres départements d'Île-de-France : Hauts-de-Seine, Seine-Saint-Denis, Val-de-Marne, Yvelines, Essonne, Val-d'Oise et Seine-et-Marne. En grande couronne, nous vérifions avec vous la faisabilité selon votre commune." },
  { q: "Quel est le délai pour démarrer une prestation ?", a: "Après validation du devis, nous démarrons en général sous une à deux semaines, le temps d'affecter un agent qui habite votre secteur et de le former sur votre site. Une intervention ponctuelle peut être organisée plus rapidement." },
  { q: "Est-ce toujours le même agent qui intervient ?", a: "Oui. Nous affectons un agent attitré à chaque site. En cas d'absence ou de congés, un remplaçant déjà formé sur vos locaux assure le passage." },
  { q: "Qui fournit le matériel et les produits ?", a: "Pour les entreprises, nous fournissons le matériel et les produits professionnels. Chez les particuliers, l'intervenante utilise en général vos produits, ce qui vous laisse choisir ce qui entre chez vous." },
  { q: "Les particuliers bénéficient-ils du crédit d'impôt ?", a: "Oui. Le ménage et le repassage à domicile ouvrent droit à un crédit d'impôt de 50 % des sommes versées. Avec l'avance immédiate, vous ne payez que la moitié de la facture chaque mois." },
  { q: "Y a-t-il une durée d'engagement ?", a: "Nos contrats sont résiliables avec un préavis indiqué dans le contrat. Le ménage à domicile est sans engagement de durée." },
  { q: "Intervenez-vous le soir et le week-end ?", a: "Oui. Nous intervenons tôt le matin, le soir, la nuit pour certains sites et le week-end, selon les contraintes de vos locaux et de votre activité." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Neo Clean · Entreprise de nettoyage de bureaux à Paris et en Île-de-France"
  description="Entreprise de nettoyage à Paris : bureaux, commerces, copropriétés, fin de chantier et ménage à domicile en Île-de-France. Agent attitré, visite et devis gratuits sous 24 h."
  schema={[faqSchema]}
>
  <HomeHero />

  <!-- Bande de confiance -->
  <section class="trust">
    <div class="wrap">
      <ul>
        {trust.map((t) => (
          <li><span class="ico"><Icon name={t.i} size={22} /></span><span><b>{t.t}</b>{t.d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Deux publics -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Nos clients</span>
        <h2>Professionnels ou particuliers, un service pensé pour vous</h2>
      </div>
      <div class="split">
        <a class="split__card" href="/nettoyage-professionnel/">
          <Photo name="coworking-2" sizes="(max-width: 700px) 100vw, 50vw" class="split__img" />
          <span class="split__body">
            <span class="split__tag">Entreprises</span>
            <strong>Bureaux, commerces, copropriétés</strong>
            <span>Contrat d'entretien régulier ou intervention ponctuelle : bureaux, coworkings, boutiques, cabinets médicaux, parties communes, fins de chantier.</span>
            <span class="go">{pro.length} services professionnels <Icon name="arrow" size={18} /></span>
          </span>
        </a>
        <a class="split__card split__card--home" href="/services-de-menage-a-domicile/">
          <Photo name="regulier-1" sizes="(max-width: 700px) 100vw, 50vw" class="split__img" />
          <span class="split__body">
            <span class="split__tag">Particuliers</span>
            <strong>Ménage et repassage à domicile</strong>
            <span>Ménage régulier ou ponctuel, repassage, locations Airbnb, aide aux seniors. 50 % de crédit d'impôt et avance immédiate.</span>
            <span class="go">Le ménage à domicile <Icon name="arrow" size={18} /></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Services pro -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">Services aux entreprises</span>
          <h2>Ce que nous entretenons</h2>
        </div>
        <p class="lede">Chaque prestation fait l'objet d'un cahier des charges écrit : vous savez exactement ce qui est fait, à quelle fréquence et à quel prix.</p>
      </div>
      <div class="svc-grid">
        {featured.map((s) => (
          <a class="svc" href={serviceHref(s)}>
            <Photo name={s.data.photos[0]} sizes="(max-width: 700px) 100vw, 25vw" widths={[480, 800]} class="svc__img" />
            <span class="svc__body">
              <span class="svc__ico"><Icon name={s.data.icon} size={20} /></span>
              <strong>{s.data.title}</strong>
              <small>{s.data.summary}</small>
            </span>
          </a>
        ))}
      </div>
      <p class="all"><a class="btn btn--ghost" href="/nettoyage-professionnel/">Voir les {pro.length} services professionnels <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- Texte de présentation -->
  <section class="section">
    <div class="wrap intro">
      <div class="intro__text article">
        <span class="eyebrow">Neo Clean</span>
        <h2>Une entreprise de nettoyage parisienne, au service de toute l'Île-de-France</h2>
        <p>Neo Clean est une entreprise de nettoyage installée au 61 rue de Lyon, dans le 12e arrondissement de Paris. Nous entretenons les bureaux, les commerces, les cabinets médicaux, les hôtels et les parties communes d'immeubles, et proposons aux particuliers le ménage, le repassage et l'aide à domicile.</p>
        <p>Notre conviction est simple : dans le nettoyage, la qualité du service dépend presque entièrement des personnes qui le réalisent. Nous avons donc construit notre organisation autour de nos agents. Ils sont salariés, le plus souvent en CDI, formés à nos protocoles et encadrés par des responsables de secteur qui visitent régulièrement les sites.</p>
        <p>Pour nos clients, cela se traduit concrètement : un agent attitré qui connaît vos locaux, un cahier des charges écrit qui précise ce qui est fait pièce par pièce, un remplaçant formé quand l'agent est absent, et un interlocuteur que vous pouvez appeler directement. Pas de centre d'appels, pas de nouvel intervenant chaque semaine.</p>
        <h3>Des méthodes professionnelles</h3>
        <p>Nous travaillons avec des microfibres à code couleur pour séparer les zones, des désinfectants conformes aux normes européennes pour les sanitaires et les points de contact, et du matériel mécanisé pour les grandes surfaces. Chaque revêtement de sol reçoit le traitement qui lui convient, de la moquette au marbre.</p>
        <h3>Des horaires adaptés à votre activité</h3>
        <p>Nous intervenons tôt le matin, le soir, la nuit pour les sites logistiques et le week-end, pour que vos locaux soient prêts quand vos équipes, vos clients ou vos résidents arrivent.</p>
      </div>
      <div class="intro__media">
        <Photo name="equipe-2" sizes="(max-width: 900px) 100vw, 35vw" class="intro__img" />
        <blockquote>
          « Le bien-être de nos employés est la clé de la satisfaction de nos clients. »
          <cite>Le fondateur de Neo Clean</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <Commitments photo="copro-2" />

  <Process />

  <!-- Particuliers -->
  <section class="section section--paper">
    <div class="wrap home">
      <div class="home__media">
        <Photo name="domicile-1" sizes="(max-width: 900px) 100vw, 45vw" class="home__img" />
        <div class="price">
          <span class="price__label">Ménage à domicile, à partir de</span>
          <span class="price__value">17,65 €<small>/h</small></span>
          <span class="price__note">après crédit d'impôt · 35,30 € TTC facturés</span>
        </div>
      </div>
      <div class="home__text">
        <span class="eyebrow">Ménage à domicile</span>
        <h2>Chez vous, la même intervenante à chaque passage</h2>
        <p class="lede">Nous recrutons, déclarons et remplaçons votre intervenante. Vous n'avez aucune démarche d'employeur, et vous ne payez que la moitié grâce au crédit d'impôt et à l'avance immédiate.</p>
        <ul class="home__list">
          {home.map((s) => (
            <li>
              <a href={serviceHref(s)}>
                <span class="ico"><Icon name={s.data.icon} size={20} /></span>
                <span><strong>{s.data.title}</strong><small>{s.data.summary}</small></span>
                <Icon name="arrow" size={18} class="arr" />
              </a>
            </li>
          ))}
        </ul>
        <div class="actions">
          <a class="btn btn--primary" href="/devis/?type=particulier">Demander un devis</a>
          <a class="btn btn--ghost" href="/tarifs/">Tarifs et crédit d'impôt</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Zones -->
  <section class="section">
    <div class="wrap zones">
      <div class="zones__text">
        <span class="eyebrow">Zones d'intervention</span>
        <h2>Paris et les huit départements d'Île-de-France</h2>
        <p class="lede">Depuis notre siège du 12e arrondissement, nos équipes sont organisées par secteur. Chaque agent intervient près de chez lui : c'est la meilleure garantie de ponctualité.</p>
        <ul class="zones__list">
          {zones.map((z) => (
            <li><a href={zoneHref(z)}><b>{z.data.code}</b><span>Nettoyage {z.data.in}</span><Icon name="arrow" size={16} /></a></li>
          ))}
        </ul>
      </div>
      <IdfMap />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Vos questions, nos réponses</h2>
        <p class="lede">D'autres questions ? <a href="/faq/">Consultez toute la FAQ</a> ou appelez-nous au <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Bande de confiance */
  .trust {
    border-block: 1px solid var(--line);
    background: #fff;
  }
  .trust ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 24px 20px;
  }
  .trust li + li {
    border-left: 1px solid var(--line);
  }
  .trust .ico {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--blue-soft);
    color: var(--blue);
  }
  .trust li span:last-child {
    display: grid;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .trust b {
    font: 600 1rem var(--display);
    color: var(--ink);
  }

  /* Deux publics */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .split__card {
    position: relative;
    display: block;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }
  .split__card :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .split__card :global(.split__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s;
  }
  .split__card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(12 25 50 / 0.05) 20%, rgb(12 25 50 / 0.9) 100%);
  }
  .split__card:hover :global(.split__img) {
    transform: scale(1.04);
  }
  .split__body {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 10px;
    padding: clamp(22px, 3.5vw, 36px);
  }
  .split__tag {
    justify-self: start;
    font: 600 0.75rem var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--blue);
    padding: 5px 10px;
    border-radius: 6px;
  }
  .split__card--home .split__tag {
    background: var(--pink);
  }
  .split__body strong {
    font: 700 clamp(1.4rem, 2.4vw, 1.8rem)/1.2 var(--display);
  }
  .split__body > span:not(.split__tag):not(.go) {
    color: rgb(255 255 255 / 0.85);
    max-width: 48ch;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 1rem var(--display);
    color: #fff;
  }

  /* Services */
  .section-head--row {
    max-width: none;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 24px 64px;
  }
  .section-head--row > div {
    display: grid;
    gap: 14px;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .svc {
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .svc:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
    color: var(--ink);
  }
  .svc :global(.svc__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .svc__body {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 30px 20px 22px;
    align-content: start;
  }
  .svc__ico {
    position: absolute;
    top: -22px;
    left: 20px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: #fff;
    box-shadow: 0 8px 20px -6px rgb(31 95 209 / 0.6);
  }
  .svc strong {
    font: 600 1.08rem var(--display);
  }
  .svc small {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .all {
    margin-top: 32px;
    text-align: center;
  }

  /* Présentation */
  .intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .intro__text h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    margin-top: 12px;
  }
  .intro__media {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 0;
  }
  .intro__media :global(.intro__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
  }
  .intro__media blockquote {
    margin: -60px 20px 0;
    position: relative;
    padding: 22px 24px;
    background: var(--navy);
    color: #fff;
    border-radius: 18px;
    font: 500 1.08rem/1.5 var(--display);
  }
  .intro__media cite {
    display: block;
    margin-top: 10px;
    font: 500 0.85rem var(--body);
    font-style: normal;
    color: var(--lime);
  }

  /* Particuliers */
  .home {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .home__media {
    position: relative;
  }
  .home__media :global(.home__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px 120px 24px 24px;
  }
  .price {
    position: absolute;
    right: -16px;
    bottom: 28px;
    display: grid;
    gap: 2px;
    padding: 18px 22px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 24px 48px -16px rgb(15 29 51 / 0.3);
  }
  .price__label {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .price__value {
    font: 700 2.2rem/1.1 var(--display);
    color: var(--pink);
    font-variant-numeric: tabular-nums;
  }
  .price__value small {
    font-size: 1rem;
    color: var(--muted);
  }
  .price__note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .home__text {
    display: grid;
    gap: 20px;
  }
  .home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .home__list a {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 12px 16px 12px 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .home__list a:hover {
    border-color: var(--pink);
  }
  .home__list .ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #fce8f1;
    color: var(--pink);
  }
  .home__list strong {
    display: block;
    font: 600 1rem var(--display);
  }
  .home__list small {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .home__list :global(.arr) {
    color: var(--muted);
  }

  /* Zones */
  .zones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .zones__text {
    display: grid;
    gap: 16px;
  }
  .zones__list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .zones__list a {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 10px 14px 10px 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.93rem;
  }
  .zones__list a:hover {
    border-color: var(--blue);
  }
  .zones__list b {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    font: 700 0.9rem var(--display);
  }
  .zones__list :global(svg) {
    color: var(--muted);
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .faq-wrap .section-head {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  @media (max-width: 1000px) {
    .svc-grid {
      grid-template-columns: 1fr 1fr;
    }
    .trust ul {
      grid-template-columns: 1fr 1fr;
    }
    .trust li:nth-child(3) {
      border-left: 0;
    }
    .trust li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 900px) {
    .intro,
    .home,
    .zones,
    .faq-wrap,
    .section-head--row {
      grid-template-columns: 1fr;
    }
    .intro__media,
    .faq-wrap .section-head {
      position: static;
    }
    .intro__media :global(.intro__img),
    .home__media :global(.home__img) {
      aspect-ratio: 16 / 11;
    }
    .price {
      right: 12px;
    }
  }
  @media (max-width: 640px) {
    .split,
    .svc-grid {
      grid-template-columns: 1fr;
    }
    .split__card {
      min-height: 380px;
    }
    .trust ul {
      grid-template-columns: 1fr;
    }
    .trust li,
    .trust li + li {
      border-left: 0;
      padding: 16px 0;
    }
    .trust li + li {
      border-top: 1px solid var(--line);
    }
    .zones__list {
      grid-template-columns: 1fr;
    }
  }
</style>
