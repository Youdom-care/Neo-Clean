---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import IdfMap from "../components/IdfMap.astro";
import CtaBand from "../components/CtaBand.astro";
import Process from "../components/Process.astro";
import Commitments from "../components/Commitments.astro";
import { site } from "../data/site";
import { getZones, getProServices, getHomeServices, serviceHref, zoneHref, type ZoneEntry } from "../lib/content";

export async function getStaticPaths() {
  const zones = await getZones();
  return zones.map((z) => ({ params: { zone: z.id }, props: { entry: z } }));
}
const { entry } = Astro.props as { entry: ZoneEntry };
const z = entry.data;
const { Content } = await render(entry);
const pro = await getProServices();
const home = await getHomeServices();
const zones = await getZones();
const others = zones.filter((o) => o.id !== entry.id);

const title = `Entreprise de nettoyage ${z.in} (${z.code}) · bureaux, commerces, copropriétés | Neo Clean`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "HousekeepingService",
    name: `Neo Clean – ${z.name}`,
    parentOrganization: { "@id": `${site.url}/#entreprise` },
    url: `${site.url}${zoneHref(entry)}`,
    telephone: site.phone.replace(/\s/g, ""),
    areaServed: [
      { "@type": "AdministrativeArea", name: `${z.name} (${z.code})` },
      ...z.cities.map((c) => ({ "@type": "City", name: c })),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Zones d'intervention", item: `${site.url}/zones-d-intervention/` },
      { "@type": "ListItem", position: 3, name: z.name, item: `${site.url}${zoneHref(entry)}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: z.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title={title} description={z.metaDescription} schema={schema}>
  <!-- En-tête local -->
  <section class="zhero">
    <div class="zhero__bg">
      <Photo name={z.photo} loading="eager" sizes="100vw" class="zhero__img" />
    </div>
    <div class="wrap zhero__grid">
      <div class="zhero__text">
        <nav class="crumbs" aria-label="Fil d'Ariane">
          <ol>
            <li><a href="/">Accueil</a></li>
            <li><a href="/zones-d-intervention/">Zones d'intervention</a></li>
            <li aria-current="page">{z.name}</li>
          </ol>
        </nav>
        <div class="code-row">
          <span class="code">{z.code}</span>
          <span class="code-lbl">{z.name}<small>Île-de-France</small></span>
        </div>
        <h1>Entreprise de nettoyage {z.in}</h1>
        <p class="lede">{z.lede}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/devis/">Devis gratuit {z.in} <Icon name="arrow" size={18} /></a>
          <a class="btn btn--light" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        </div>
        <dl class="kpis">
          <div><dt>Communes desservies</dt><dd>{z.cities.length}+</dd></div>
          <div><dt>Services proposés</dt><dd>{pro.length + home.length}</dd></div>
          <div><dt>Réponse au devis</dt><dd>24 h</dd></div>
        </dl>
      </div>
      <div class="zhero__map">
        <IdfMap active={entry.id} />
      </div>
    </div>
  </section>

  <!-- Secteurs -->
  <section class="sectors">
    <div class="wrap">
      <ul class="sectors__list">
        {z.areas.map((a) => (
          <li>
            <Icon name="pin" size={20} />
            <div><h2>{a.name}</h2><p>{a.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Contenu -->
  <section class="section">
    <div class="wrap body">
      <article class="article">
        <Content />
      </article>
      <aside class="side">
        <div class="card">
          <span class="k">Nos services {z.in}</span>
          <ul class="svc">
            {pro.slice(0, 8).map((s) => (
              <li><a href={serviceHref(s)}><Icon name={s.data.icon} size={18} />{s.data.title}</a></li>
            ))}
          </ul>
          <a class="more" href="/nettoyage-professionnel/">Tous les services <Icon name="arrow" size={16} /></a>
        </div>
        <div class="card card--navy">
          <span class="k">Devis gratuit</span>
          <p>Visite de vos locaux {z.in} et devis détaillé, sans engagement.</p>
          <a class="btn btn--primary" href="/devis/">Demander un devis</a>
          <a class="tel" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{z.name} · {z.code}</span>
        <h2>Nos prestations de nettoyage {z.in}</h2>
        <p class="lede">Pour les entreprises, les commerces, les copropriétés et les particuliers, avec un agent attitré et un responsable de secteur joignable directement.</p>
      </div>
      <div class="cards">
        {pro.slice(0, 6).map((s) => (
          <a class="scard" href={serviceHref(s)}>
            <Photo name={s.data.photos[0]} sizes="(max-width: 700px) 100vw, 33vw" widths={[480, 800]} class="scard__img" />
            <span class="scard__body">
              <strong>{s.data.title}</strong>
              <small>{s.data.summary}</small>
              <span class="go">En savoir plus <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        ))}
      </div>
      <div class="home-strip">
        <span class="k">Particuliers {z.in}</span>
        <ul class="chips">
          {home.map((s) => <li><a href={serviceHref(s)}><Icon name={s.data.icon} size={16} />{s.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <Commitments photo="equipe-2" />

  <Process />

  <!-- Communes + FAQ -->
  <section class="section">
    <div class="wrap local">
      <div>
        <span class="eyebrow">Communes</span>
        <h2>Communes desservies {z.in}</h2>
        <ul class="chips cities">{z.cities.map((c) => <li>{c}</li>)}</ul>
        <p class="muted">Votre commune n'apparaît pas ? Indiquez votre code postal dans la <a href="/devis/">demande de devis</a> : nous vous confirmons sous 24 h ouvrées si nous pouvons intervenir.</p>
      </div>
      <div>
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Nettoyage {z.in} : vos questions</h2>
        <div class="faq">
          {z.faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <div><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <h2 class="h-sm">Nous intervenons aussi</h2>
      <ul class="chips">
        {others.map((o) => <li><a href={zoneHref(o)}><Icon name="pin" size={16} />{o.data.name} ({o.data.code})</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand title={`Un devis pour vos locaux ${z.in}`} />
</Base>

<style>
  .zhero {
    position: relative;
    color: #fff;
    background: var(--ink);
    overflow: hidden;
  }
  .zhero__bg {
    position: absolute;
    inset: 0;
  }
  .zhero__bg :global(picture),
  .zhero__bg :global(.zhero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zhero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(12 25 50 / 0.95) 0%, rgb(18 48 107 / 0.88) 55%, rgb(18 48 107 / 0.6) 100%);
  }
  .zhero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 6vw, 80px);
  }
  .zhero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .zhero .crumbs ol {
    margin: 0;
    color: rgb(255 255 255 / 0.7);
  }
  .zhero .crumbs a {
    color: rgb(255 255 255 / 0.8);
  }
  .zhero .crumbs li + li::before {
    color: rgb(255 255 255 / 0.4);
  }
  .code-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .code {
    font: 800 3.4rem/1 var(--display);
    letter-spacing: -0.04em;
    color: var(--lime);
  }
  .code-lbl {
    display: grid;
    font: 600 1.1rem/1.2 var(--display);
    padding-left: 14px;
    border-left: 2px solid rgb(255 255 255 / 0.25);
  }
  .code-lbl small {
    font: 500 0.85rem var(--body);
    color: rgb(255 255 255 / 0.65);
  }
  .zhero h1 {
    font-size: clamp(2rem, 4.4vw, 3.3rem);
    max-width: 16ch;
  }
  .zhero .lede {
    color: rgb(255 255 255 / 0.85);
  }
  .kpis {
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 28px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .kpis div {
    display: grid;
    gap: 2px;
  }
  .kpis dt {
    order: 2;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.7);
  }
  .kpis dd {
    order: 1;
    margin: 0;
    font: 700 1.9rem/1 var(--display);
    font-variant-numeric: tabular-nums;
  }
  .zhero__map {
    max-width: 480px;
    width: 100%;
    justify-self: end;
    color: var(--ink);
  }

  .sectors {
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .sectors__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .sectors__list li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    padding: 28px 22px 28px 0;
  }
  .sectors__list li + li {
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }
  .sectors__list :global(svg) {
    color: var(--pink);
    margin-top: 2px;
  }
  .sectors__list h2 {
    font-size: 1rem;
    margin-bottom: 6px;
  }
  .sectors__list p {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .body {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 16px;
  }
  .card {
    display: grid;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
  }
  .k {
    font: 600 0.75rem var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .svc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .svc a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .svc a:hover {
    color: var(--blue);
  }
  .svc :global(svg) {
    color: var(--blue);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 0.92rem var(--display);
  }
  .card--navy {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .card--navy .k {
    color: var(--lime);
  }
  .card--navy p {
    color: rgb(255 255 255 / 0.8);
    font-size: 0.95rem;
  }
  .tel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    font: 600 1rem var(--display);
    text-decoration: none;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .scard {
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .scard:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    color: var(--ink);
  }
  .scard :global(.scard__img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .scard__body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 22px;
    align-content: start;
  }
  .scard strong {
    font: 600 1.1rem var(--display);
  }
  .scard small {
    color: var(--muted);
    font-size: 0.93rem;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 0.9rem var(--display);
    color: var(--blue);
  }
  .home-strip {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  .home-strip :global(svg) {
    color: var(--pink);
  }

  .local {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .local > div {
    display: grid;
    gap: 16px;
  }
  .muted {
    color: var(--muted);
  }
  .h-sm {
    font-size: 1.4rem;
    margin-bottom: 18px;
  }
  .chips :global(svg) {
    color: var(--pink);
  }

  @media (max-width: 1000px) {
    .sectors__list {
      grid-template-columns: 1fr 1fr;
    }
    .sectors__list li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .sectors__list li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 900px) {
    .zhero__grid,
    .body,
    .local {
      grid-template-columns: 1fr;
    }
    .zhero__map {
      justify-self: stretch;
      max-width: 440px;
    }
    .side {
      position: static;
    }
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .sectors__list,
    .cards {
      grid-template-columns: 1fr;
    }
    .sectors__list li,
    .sectors__list li + li {
      padding: 20px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .sectors__list li:first-child {
      border-top: 0;
    }
    .kpis {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .kpis dd {
      font-size: 1.5rem;
    }
    .zhero .actions,
    .zhero .btn {
      width: 100%;
    }
  }
</style>
