---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---
<Base title="Demande envoyée | Neo Clean" description="Votre demande de devis a bien été envoyée." noindex>
  <section class="section">
    <div class="wrap thanks">
      <span class="ok"><Icon name="check" size={36} /></span>
      <h1>Demande envoyée</h1>
      <p class="lede">Merci. Un conseiller vous recontacte sous 24 h ouvrées. Pour une demande urgente, appelez-nous au <a href={site.phoneHref}>{site.phone}</a>.</p>
      <a class="btn btn--ghost" href="/">Retour à l'accueil</a>
    </div>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    gap: 20px;
    justify-items: center;
    text-align: center;
    max-width: 640px;
  }
  .ok {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #eef6d6;
    color: #5b7a00;
  }
</style>
