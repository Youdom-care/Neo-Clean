{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/(wp-admin|wp-login.php|xmlrpc.php|wp-content|wp-includes|wp-json)/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nettoyage-divers/",
      "destination": "/nettoyage-professionnel/",
      "permanent": true
    },
    {
      "source": "/nettoyage-moquette/",
      "destination": "/entretien-des-sols/",
      "permanent": true
    },
    {
      "source": "/entretien-des-parquets/",
      "destination": "/entretien-des-sols/",
      "permanent": true
    },
    {
      "source": "/entretien-sol-en-marbre/",
      "destination": "/entretien-des-sols/",
      "permanent": true
    },
    {
      "source": "/lessivage-des-murs/",
      "destination": "/entretien-des-sols/",
      "permanent": true
    },
    {
      "source": "/nettoyage-de-residences/",
      "destination": "/nettoyage-petite-copropriete/",
      "permanent": true
    },
    {
      "source": "/distribution-de-courrier/",
      "destination": "/nettoyage-petite-copropriete/",
      "permanent": true
    },
    {
      "source": "/remplacement-de-gardien/",
      "destination": "/nettoyage-petite-copropriete/",
      "permanent": true
    },
    {
      "source": "/entrees-sorties-de-poubelles/",
      "destination": "/nettoyage-petite-copropriete/",
      "permanent": true
    },
    {
      "source": "/entretien-despaces-verts/",
      "destination": "/nettoyage-petite-copropriete/",
      "permanent": true
    },
    {
      "source": "/nettoyage-de-restaurants/",
      "destination": "/nettoyage-commerce/",
      "permanent": true
    },
    {
      "source": "/nettoyage-dhotel/",
      "destination": "/nettoyage-hotel/",
      "permanent": true
    },
    {
      "source": "/nettoyage-dhopital/",
      "destination": "/nettoyage-et-entretien-cabinet-medical-clinique-pharmacie/",
      "permanent": true
    },
    {
      "source": "/nettoyage-de-parking/",
      "destination": "/nettoyage-industriel/",
      "permanent": true
    },
    {
      "source": "/credit-dimpots/",
      "destination": "/tarifs/#credit-impot",
      "permanent": true
    },
    {
      "source": "/nos-moyens-de-paiement/",
      "destination": "/tarifs/",
      "permanent": true
    },
    {
      "source": "/fonctionnement/",
      "destination": "/qui-sommes-nous/",
      "permanent": true
    },
    {
      "source": "/le-concept/",
      "destination": "/qui-sommes-nous/",
      "permanent": true
    },
    {
      "source": "/politique-dentreprise/",
      "destination": "/qui-sommes-nous/",
      "permanent": true
    },
    {
      "source": "/partenaires/",
      "destination": "/qui-sommes-nous/",
      "permanent": true
    },
    {
      "source": "/postuler/",
      "destination": "/recrutement/",
      "permanent": true
    },
    {
      "source": "/devis-2/",
      "destination": "/devis/",
      "permanent": true
    },
    {
      "source": "/contact-2/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/page-d-exemple/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/conditions-legales/",
      "destination": "/mentions-legales/",
      "permanent": true
    },
    {
      "source": "/protection-de-la-vie-privee/",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/politique-de-gestion-des-cookies/",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/elementor-hf/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/elementskit-content/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io mailto:; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
