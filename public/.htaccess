# Neo Clean — configuration Apache / LiteSpeed (Hostinger)

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS et domaine sans www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://neo-clean.fr%{REQUEST_URI} [L,R=301]

  # Anciens chemins WordPress : on coupe court (bots de scan)
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-content|wp-includes|wp-json) - [G,L]
</IfModule>

# Redirections des anciennes pages (site WordPress) vers les nouvelles
Redirect 301 /nettoyage-divers/ /nettoyage-professionnel/
Redirect 301 /nettoyage-moquette/ /entretien-des-sols/
Redirect 301 /entretien-des-parquets/ /entretien-des-sols/
Redirect 301 /entretien-sol-en-marbre/ /entretien-des-sols/
Redirect 301 /lessivage-des-murs/ /entretien-des-sols/
Redirect 301 /nettoyage-de-residences/ /nettoyage-petite-copropriete/
Redirect 301 /distribution-de-courrier/ /nettoyage-petite-copropriete/
Redirect 301 /remplacement-de-gardien/ /nettoyage-petite-copropriete/
Redirect 301 /entrees-sorties-de-poubelles/ /nettoyage-petite-copropriete/
Redirect 301 /entretien-despaces-verts/ /nettoyage-petite-copropriete/
Redirect 301 /nettoyage-de-restaurants/ /nettoyage-commerce/
Redirect 301 /nettoyage-dhotel/ /nettoyage-hotel/
Redirect 301 /nettoyage-dhopital/ /nettoyage-et-entretien-cabinet-medical-clinique-pharmacie/
Redirect 301 /nettoyage-de-parking/ /nettoyage-industriel/
Redirect 301 /credit-dimpots/ /tarifs/#credit-impot
Redirect 301 /nos-moyens-de-paiement/ /tarifs/
Redirect 301 /fonctionnement/ /qui-sommes-nous/
Redirect 301 /le-concept/ /qui-sommes-nous/
Redirect 301 /politique-dentreprise/ /qui-sommes-nous/
Redirect 301 /partenaires/ /qui-sommes-nous/
Redirect 301 /postuler/ /recrutement/
Redirect 301 /devis-2/ /devis/
Redirect 301 /contact-2/ /contact/
Redirect 301 /blog/ /
Redirect 301 /page-d-exemple/ /
Redirect 301 /conditions-legales/ /mentions-legales/
Redirect 301 /protection-de-la-vie-privee/ /confidentialite/
Redirect 301 /politique-de-gestion-des-cookies/ /confidentialite/
RedirectMatch 301 ^/elementor-hf/.* /
RedirectMatch 301 ^/elementskit-content/.* /

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'"
  Header unset X-Powered-By

  # Cache long pour les fichiers versionnés
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
